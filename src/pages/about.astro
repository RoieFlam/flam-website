---
import Base from '../layouts/Base.astro';
import { site } from '../config/site';

const principles = [
  { title: 'Business first, design second', text: 'Every project starts with how your business works: who your customers are, how they decide, and what happens after someone gets in touch. Your digital presence and dashboard are shaped around that.' },
  { title: 'One clear next step', text: 'Visitors shouldn’t have to guess what to do. Each site is built around a single, obvious way to get in touch.' },
  { title: 'Simple over clever', text: 'A dashboard you actually open every day beats a powerful system you avoid. Statuses, notes and next actions, and not much more.' },
  { title: 'Honest about what’s controllable', text: 'FLAM commits to the work it controls: your online presence, the contact path, the dashboard, quality checks and agreed setup. Results depend on more than a website, and FLAM won’t pretend otherwise.' },
];
---
<Base title="About" description="FLAM is led by Roie Flam and takes a business-first approach to helping small service businesses and clinics look professional online and handle inquiries clearly.">
  <section class="about-hero">
    <div class="container about-hero__grid">
      <div>
        <p class="eyebrow">About FLAM</p>
        <h1 class="about-hero__title">A founder-led studio, run by {site.founder}.</h1>
      </div>
      <p class="lead">
        FLAM helps small service businesses and clinics look more professional online and handle their inquiries more clearly.
        It’s deliberately small: you work directly with Roie, from the first planning call through launch.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="approach-title">
    <div class="container about-grid">
      <aside class="founder" aria-label="Founder">
        <div class="founder__mono" aria-hidden="true">RF</div>
        <p class="founder__name">{site.founder}</p>
        <p class="founder__role">Founder, FLAM</p>
      </aside>

      <div>
        <h2 id="approach-title" class="h2">How FLAM works</h2>
        <ol role="list" class="principles">
          {principles.map((p, i) => (
            <li>
              <span class="principles__n">{String(i + 1).padStart(2, '0')}</span>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </li>
          ))}
        </ol>

        <div class="isnt">
          <h2 class="isnt__title">What FLAM isn’t</h2>
          <ul role="list">
            <li><strong>Not a big agency.</strong> There’s no account manager in between; you talk to the person responsible for your project.</li>
            <li><strong>Not a one-size-fits-all platform.</strong> Your product is set up for your business alone. Nothing is shared with other businesses.</li>
            <li><strong>Not a promise of results.</strong> FLAM delivers a professional digital presence and a clear way to manage inquiries; what you do with them is still your business.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--sunk" aria-labelledby="about-cta-title">
    <div class="container about-cta">
      <h2 id="about-cta-title" class="h2">Ready to plan your project?</h2>
      <p class="lead">Share a few details about your business and Roie will reply to arrange a short planning call.</p>
      <div class="actions">
        <a href="/#plan" class="btn btn--primary" data-cta="about_plan">Plan your project</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .about-hero { padding-block: clamp(56px, 8vw, 112px) clamp(48px, 6vw, 80px); border-bottom: var(--hairline); }
  .about-hero__grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 96px); align-items: end; }
  .about-hero__title { font-size: clamp(2.25rem, 1.5rem + 3vw, 3.75rem); letter-spacing: -0.03em; max-width: 16ch; }

  .about-grid { display: grid; grid-template-columns: 260px minmax(0, 1fr); gap: clamp(40px, 6vw, 96px); align-items: start; }
  .founder { position: sticky; top: 120px; border-top: 2px solid var(--ink); padding-top: var(--s-5); display: grid; gap: 4px; }
  .founder__mono {
    width: 88px; height: 88px; border-radius: var(--r-sm); background: var(--accent); color: #fff;
    display: grid; place-items: center; font-weight: 600; font-size: 1.6rem; letter-spacing: 0.04em; margin-bottom: var(--s-4);
  }
  .founder__name { font-weight: 600; font-size: 1.15rem; }
  .founder__role { color: var(--muted); font-size: var(--fs-small); margin-bottom: var(--s-3); }

  .principles { margin-top: var(--s-6); }
  .principles li { display: grid; grid-template-columns: 48px 1fr; column-gap: var(--s-4); row-gap: var(--s-2); padding-block: var(--s-5); border-top: var(--hairline); }
  .principles__n { font-family: var(--font-mono); font-size: 0.85rem; color: var(--accent); grid-row: span 2; padding-top: 4px; }
  .principles h3 { font-size: var(--fs-h3); }
  .principles p { color: var(--ink-2); max-width: 60ch; }

  .isnt { margin-top: var(--s-8); padding: var(--s-6); background: var(--surface); border: var(--hairline); border-radius: var(--r-md); }
  .isnt__title { font-size: 1.35rem; margin-bottom: var(--s-4); }
  .isnt li { color: var(--ink-2); padding-block: var(--s-3); border-top: var(--hairline); }
  .isnt li strong { color: var(--ink); }

  .about-cta { display: grid; gap: var(--s-5); justify-items: start; }

  @media (max-width: 860px) {
    .about-hero__grid, .about-grid { grid-template-columns: 1fr; }
    .founder { position: static; grid-template-columns: auto 1fr; column-gap: var(--s-4); align-items: center; }
    .founder__mono { grid-row: span 3; width: 64px; height: 64px; font-size: 1.2rem; margin-bottom: 0; }
    .founder__role { margin-bottom: 0; }
  }
  @media (max-width: 560px) {
    .principles li { grid-template-columns: 1fr; }
    .principles__n { grid-row: auto; padding-top: 0; }
    .isnt { padding: var(--s-5); }
  }
</style>

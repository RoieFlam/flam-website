---
import Base from '../layouts/Base.astro';
import ProjectForm from '../components/ProjectForm.astro';
import DemoMockup from '../components/DemoMockup.astro';
import { site } from '../config/site';

const included = [
  { title: 'A professional online presence', text: 'Clear, mobile-first, and built around how your customers decide.' },
  { title: 'A clear way to reach you', text: 'A short form and WhatsApp, so getting in touch takes one step.' },
  { title: 'Your inquiry dashboard', text: 'Every inquiry in one place, with a simple status and a next action.' },
  { title: 'Setup and support', text: 'FLAM sets everything up, checks it, and supports you after launch.' },
];

const problems = [
  { title: 'Your online presence undersells you.', text: 'An outdated or unclear site makes a careful business look less careful than it is, and it rarely tells visitors what to do next.' },
  { title: 'Inquiries arrive everywhere.', text: 'WhatsApp, calls, email, a form, a note on your phone. Each one is easy to answer. Together they are easy to lose track of.' },
  { title: 'Nothing shows what is still open.', text: 'Without one list of who asked, who got a reply and who is waiting, follow-ups depend on memory.' },
];

const parts = [
  {
    side: 'What your customers see',
    title: 'Your professional presence',
    points: ['Built around your services', 'Mobile-first and fast', 'Checked on every screen size'],
  },
  {
    side: 'What your customers see',
    title: 'One clear next step',
    points: ['A short inquiry form', 'A WhatsApp option', 'No inquiry gets lost'],
  },
  {
    side: 'What you see',
    title: 'Your inquiry dashboard',
    points: ['Every inquiry in one list', 'Simple, clear statuses', 'Notes and a next action for each'],
  },
  {
    side: 'What FLAM handles',
    title: 'Setup and support',
    points: ['Set up and checked by FLAM', 'Private to your business', 'Support after launch'],
  },
];

const steps = [
  { n: '1', title: 'Plan', text: 'A short call about your business, your customers and how inquiries reach you today. You get a clear scope and price.' },
  { n: '2', title: 'Build and set up', text: 'FLAM designs and builds your digital presence and sets up your dashboard around how you work.' },
  { n: '3', title: 'Review and approve', text: 'You review everything together. Two major revision rounds are included before you approve.' },
  { n: '4', title: 'Launch and support', text: 'Everything goes live together, with 30 days of launch support.' },
];

const faqs = [
  {
    q: 'Who is FLAM for?',
    a: 'Small local service businesses and clinics, roughly 1–10 people, that get inquiries by phone, WhatsApp or a form and want a more professional online presence and a simpler way to keep track of those inquiries.',
  },
  {
    q: 'What’s included?',
    a: 'Everything your business needs online: your professional online presence, a clear way for customers to contact you, your inquiry dashboard with statuses, notes and next actions, and the setup, quality checks and launch support around it.',
  },
  {
    q: 'Will this bring me more clients?',
    a: 'FLAM can’t promise leads, revenue or conversion rates. Those depend on your market, your offer and how you follow up. What FLAM does deliver is a professional digital presence, a clear way for customers to reach you, and one place to manage every inquiry you receive.',
  },
  {
    q: 'Do I need to learn complicated software?',
    a: 'No. The dashboard is deliberately simple: a list of inquiries, a status for each, notes, and what to do next. FLAM sets it up for you.',
  },
  {
    q: 'Is my customers’ data shared with other businesses?',
    a: 'No. Each client’s product and data are kept separate. There is no shared workspace between businesses.',
  },
  {
    q: 'How long does a project take?',
    a: 'It depends on the scope and on how quickly content and feedback come in. You’ll get a timeline during planning, before any payment.',
  },
  {
    q: 'What do I need to prepare?',
    a: 'The basics about your services and customers, plus a logo and photos if you have them. If something is missing, the planning call is where you work out what’s needed and who provides it.',
  },
];
---
<Base title="FLAM">
  <!-- Hero ----------------------------------------------------- -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="eyebrow">For small service businesses and clinics</p>
        <h1 id="hero-title" class="hero__title">Your complete digital presence, built and managed for you.</h1>
        <p class="lead hero__lead">
          FLAM designs, builds and manages your business’s digital presence: a professional face online,
          a clear way for customers to reach you, and one simple dashboard where every inquiry lands, so you always know who still needs a reply.
        </p>
        <div class="actions">
          <a href="#plan" class="btn btn--primary" data-cta="hero_plan">Plan your project</a>
          <a href="#product" class="link-arrow" data-cta="hero_product">See what’s included</a>
        </div>
      </div>

      <aside class="included" aria-labelledby="included-title">
        <h2 id="included-title" class="included__title">What’s included</h2>
        <ul role="list" class="included__list">
          {included.map((item) => (
            <li>
              <span class="included__mark" aria-hidden="true"></span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </div>
            </li>
          ))}
        </ul>
        <p class="included__foot">Built and managed by FLAM, led by {site.founder}. <a href="/about" class="text-link">About FLAM</a></p>
      </aside>
    </div>
  </section>

  <!-- 1. Problem ---------------------------------------------- -->
  <section class="section" id="problem" aria-labelledby="problem-title">
    <div class="container problem">
      <div class="section-head problem__head">
        <p class="eyebrow">The problem</p>
        <h2 id="problem-title" class="h2">Good businesses lose inquiries in the gaps.</h2>
        <p class="lead">Not because the service is weak, but because the path from “interested” to “booked” is unclear for the customer and messy for you.</p>
      </div>
      <ol role="list" class="problem__list">
        {problems.map((p, i) => (
          <li>
            <span class="problem__n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 2. Product ---------------------------------------------- -->
  <section class="section section--compact" id="product" aria-labelledby="product-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">The product</p>
        <h2 id="product-title" class="h2">Everything your business needs online.</h2>
        <p class="lead">What your customers see and what you see, designed, built and managed by FLAM.</p>
      </div>

      <div class="product" role="list">
        {parts.map((part) => (
          <article class="product__part" role="listitem">
            <p class="product__for">{part.side}</p>
            <h3>{part.title}</h3>
            <ul role="list" class="checklist">
              {part.points.map((pt) => <li>{pt}</li>)}
            </ul>
            <p class="product__summary" aria-hidden="true">{part.points.join(' · ')}</p>
          </article>
        ))}
      </div>
      <p class="product__managed"><strong>Managed by FLAM.</strong> You don’t have to learn a new tool or manage anything technical before it’s useful.</p>
    </div>
  </section>

  <!-- 3. How it works ----------------------------------------- -->
  <section class="section section--sunk" id="how-it-works" aria-labelledby="how-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">How it works</p>
        <h2 id="how-title" class="h2">Four clear steps from first call to launch.</h2>
      </div>
      <ol role="list" class="steps">
        {steps.map((s) => (
          <li class="step">
            <span class="step__n" aria-hidden="true">{s.n}</span>
            <h3><span class="visually-hidden">Step {s.n}: </span>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 4. Demo ------------------------------------------------- -->
  <section class="section" id="demo" aria-labelledby="demo-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Concept preview</p>
        <h2 id="demo-title" class="h2">See where an inquiry goes.</h2>
        <p class="lead">A visual concept of the dashboard inside the product, shown with sample data for an imaginary clinic. Yours is set up around your own services.</p>
      </div>
      <DemoMockup />
      <div class="actions demo__actions">
        <a href="#plan" class="btn btn--primary" data-cta="demo_plan">Plan your project</a>
      </div>
    </div>
  </section>

  <!-- 5. FAQ -------------------------------------------------- -->
  <section class="section" id="faq" aria-labelledby="faq-title">
    <div class="container faq">
      <div class="section-head faq__head">
        <p class="eyebrow">Questions</p>
        <h2 id="faq-title" class="h2">Straight answers.</h2>
      </div>
      <div class="faq__list">
        {faqs.map((f) => (
          <details class="faq__item">
            <summary><span>{f.q}</span></summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. Final CTA + form ------------------------------------- -->
  <section class="section section--cta" id="plan" aria-labelledby="plan-title">
    <div class="container plan">
      <div class="plan__intro">
        <p class="eyebrow">Plan your project</p>
        <h2 id="plan-title" class="h2">Tell FLAM about your business.</h2>
        <p class="lead">Share a few details. Roie reads every submission personally and replies to plan the next step.</p>
        <ol role="list" class="next">
          <li><span>1</span>You share the basics here.</li>
          <li><span>2</span>Roie replies by email or WhatsApp to arrange a short planning call.</li>
          <li><span>3</span>You get a clear scope and price before anything starts.</li>
        </ol>
      </div>
      <ProjectForm />
    </div>
  </section>
</Base>

<style>
  /* Hero --------------------------------------------------------- */
  .hero { padding-block: clamp(56px, 8vw, 120px) clamp(64px, 8vw, 112px); border-bottom: var(--hairline); }
  .hero__grid { display: grid; grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr); gap: clamp(40px, 6vw, 96px); align-items: end; }
  .hero__title { font-size: var(--fs-display); letter-spacing: -0.035em; line-height: 1.02; max-width: 16ch; }
  .hero__lead { margin-top: var(--s-5); margin-bottom: var(--s-6); }

  .included { border-top: 2px solid var(--ink); padding-top: var(--s-5); }
  .included__title { font-family: var(--font-mono); font-size: var(--fs-label); text-transform: uppercase; letter-spacing: 0.08em; font-weight: 500; color: var(--muted); margin-bottom: var(--s-2); }
  .included__list li { display: grid; grid-template-columns: 24px 1fr; gap: var(--s-3); padding-block: var(--s-4); border-bottom: var(--hairline); }
  .included__mark { width: 10px; height: 10px; background: var(--accent); margin-top: 8px; clip-path: polygon(50% 0, 100% 100%, 0 100%); }
  .included h3 { font-size: 1.05rem; letter-spacing: -0.01em; }
  .included p { color: var(--ink-2); font-size: 0.95rem; margin-top: 4px; line-height: 1.5; }
  .included__foot { margin-top: var(--s-4); font-size: var(--fs-small); color: var(--muted); }

  /* Problem ------------------------------------------------------ */
  .problem { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: clamp(40px, 6vw, 96px); align-items: start; }
  .problem__head { margin-bottom: 0; position: sticky; top: 120px; }
  .problem__list li { display: grid; grid-template-columns: 48px 1fr; column-gap: var(--s-4); row-gap: var(--s-2); padding-block: var(--s-6); border-top: var(--hairline); }
  .problem__list li:last-child { border-bottom: var(--hairline); }
  .problem__n { font-family: var(--font-mono); font-size: 0.85rem; color: var(--muted); grid-row: span 2; padding-top: 4px; }
  .problem__list h3 { font-size: 1.35rem; letter-spacing: -0.015em; }
  .problem__list p { color: var(--ink-2); max-width: 52ch; }

  /* Product ------------------------------------------------------ */
  .section--compact { padding-block: clamp(56px, 7vw, 96px); }
  .section--compact .section-head { margin-bottom: var(--s-6); gap: var(--s-4); }
  .product { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border: 1px solid var(--ink); border-radius: var(--r-md); background: var(--surface); overflow: hidden; }
  .product__part { padding: var(--s-5); }
  .product__part + .product__part { border-left: var(--hairline); }
  .product__for { font-family: var(--font-mono); font-size: var(--fs-label); text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent); margin-bottom: var(--s-3); }
  .product__part h3 { font-size: 1.15rem; letter-spacing: -0.015em; margin-bottom: var(--s-3); }
  .product .checklist li { padding: 6px 0 6px 24px; font-size: 0.925rem; }
  .product .checklist li::before { top: 13px; width: 10px; height: 6px; }
  .checklist li { position: relative; padding: 10px 0 10px 28px; border-top: var(--hairline); color: var(--ink-2); }
  .checklist li::before { content: ''; position: absolute; left: 2px; top: 19px; width: 12px; height: 7px; border-left: 1.75px solid var(--accent); border-bottom: 1.75px solid var(--accent); transform: rotate(-45deg); }
  .product__summary { display: none; }
  .product__managed { margin-top: var(--s-5); max-width: 70ch; color: var(--ink-2); }
  .product__managed strong { color: var(--ink); }

  /* Steps -------------------------------------------------------- */
  .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--s-6); counter-reset: step; }
  .step { position: relative; padding-top: var(--s-6); border-top: 1px solid var(--line-strong); }
  .step__n {
    position: absolute; top: -18px; left: 0; width: 36px; height: 36px; border-radius: 50%;
    display: grid; place-items: center; background: var(--bg-sunk); border: 1px solid var(--ink);
    font-family: var(--font-mono); font-size: 0.9rem; font-weight: 500;
  }
  .step h3 { font-size: var(--fs-h3); margin-bottom: var(--s-3); }
  .step p { color: var(--ink-2); font-size: 0.975rem; }

  /* FAQ ---------------------------------------------------------- */
  .faq { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr); gap: clamp(40px, 6vw, 96px); align-items: start; }
  .faq__head { margin-bottom: 0; }
  .faq__list { border-top: 1px solid var(--ink); }
  .faq__item { border-bottom: var(--hairline); }
  .faq__item summary {
    list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: var(--s-5);
    padding-block: var(--s-5); font-weight: 600; font-size: 1.1rem; letter-spacing: -0.01em; min-height: 48px;
  }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary::after {
    content: '+'; flex: none; width: 28px; height: 28px; display: grid; place-items: center; border: 1px solid var(--line-strong); border-radius: 50%;
    color: var(--accent); font-weight: 400; transition: transform 0.2s var(--ease);
  }
  .faq__item[open] summary::after { transform: rotate(45deg); }
  .faq__item summary:hover span { color: var(--accent); }
  .faq__item p { color: var(--ink-2); padding-bottom: var(--s-5); max-width: 64ch; margin-top: calc(var(--s-2) * -1); }

  /* Plan / form -------------------------------------------------- */
  .section--cta { background: var(--bg-sunk); }
  .plan { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: clamp(40px, 6vw, 96px); align-items: start; }
  .plan__intro { position: sticky; top: 120px; }
  .plan__intro .lead { margin-top: var(--s-5); }
  .next { margin-block: var(--s-6); border-top: var(--hairline); }
  .next li { display: grid; grid-template-columns: 36px 1fr; gap: var(--s-3); padding-block: var(--s-3); border-bottom: var(--hairline); color: var(--ink-2); }
  .next span { font-family: var(--font-mono); color: var(--accent); font-size: 0.9rem; padding-top: 2px; }
  .demo__actions { margin-top: var(--s-7); }

  /* Responsive --------------------------------------------------- */
  @media (max-width: 1100px) {
    .steps { grid-template-columns: repeat(2, 1fr); row-gap: var(--s-8); }
  }
  @media (max-width: 960px) {
    .hero__grid { grid-template-columns: 1fr; align-items: start; }
    .hero__title { max-width: 16ch; }
    .included { max-width: 640px; }
    .problem, .faq, .plan { grid-template-columns: 1fr; }
    .problem__head, .plan__intro { position: static; }
    .problem__head, .faq__head { margin-bottom: 0; }
    .next { margin-bottom: var(--s-4); }
  }
  @media (max-width: 1200px) {
    .product__for { display: none; }
  }
  @media (max-width: 900px) {
    .product { grid-template-columns: 1fr 1fr; }
    .product__part + .product__part { border-left: 0; }
    .product__part:nth-child(even) { border-left: var(--hairline); }
    .product__part:nth-child(n + 3) { border-top: var(--hairline); }
  }
  @media (max-width: 560px) {
    .product { grid-template-columns: 1fr; }
    .product__part { padding: var(--s-4); }
    .product__part:nth-child(even) { border-left: 0; }
    .product__part + .product__part { border-top: var(--hairline); }
    .product__for { display: none; }
    .product__part h3 { font-size: 1.05rem; margin-bottom: 4px; }
    .product .checklist { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .product__summary { display: block; color: var(--ink-2); font-size: 0.9rem; line-height: 1.5; }
    .included { display: none; }
    .hero { padding-top: var(--s-7); }
    .hero__lead { margin-bottom: var(--s-5); }
    .included__list li { grid-template-columns: 32px 1fr; padding-block: var(--s-3); }
    .problem__list li { grid-template-columns: 1fr; padding-block: var(--s-5); }
    .problem__n { grid-row: auto; padding-top: 0; }
    .problem__list h3 { font-size: 1.2rem; }
    .steps { grid-template-columns: 1fr; row-gap: 0; border-left: 1px solid var(--line-strong); margin-left: 18px; }
    .step { border-top: 0; padding: 0 0 var(--s-6) var(--s-6); }
    .step:last-child { padding-bottom: 0; }
    .step__n { left: -18px; top: -6px; }
    .faq__item summary { font-size: 1.025rem; padding-block: var(--s-4); }
  }
</style>

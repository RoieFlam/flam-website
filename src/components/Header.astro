---
import Logo from './Logo.astro';
import { getTranslations, localizedPath, type Locale, type PageKey } from '../i18n';

interface Props {
  locale: Locale;
  page: PageKey;
}

const { locale, page } = Astro.props;
const t = getTranslations(locale);
const query = Astro.url.search;
const otherLocale: Locale = locale === 'he' ? 'en' : 'he';
const languageHref = `${localizedPath(otherLocale, page)}${query}`;
const nav = [
  { href: localizedPath(locale, 'home', '#product'), label: t.navigation.product, section: 'product' },
  { href: localizedPath(locale, 'home', '#how-it-works'), label: t.navigation.howItWorks, section: 'how-it-works' },
  { href: localizedPath(locale, 'home', '#demo'), label: t.navigation.demo, section: 'demo' },
  { href: localizedPath(locale, 'about'), label: t.navigation.about, page: 'about' },
];
const currentSection = page === 'home' ? Astro.url.hash.slice(1) : '';
const currentState = (item: (typeof nav)[number]) => {
  if (item.page) return page === item.page ? 'page' : undefined;
  return item.section === currentSection ? 'location' : undefined;
};
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <Logo locale={locale} />

    <nav class="site-nav" aria-label={t.navigation.main}>
      <ul role="list" class="site-nav__list">
        {nav.map((item) => <li><a href={item.href} aria-current={currentState(item)} data-nav-section={item.section}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="language-switch" href={languageHref} hreflang={otherLocale} lang={otherLocale} aria-label={t.switcher.switchTo[otherLocale]} data-language-switch>
        <span aria-current="page">{locale.toUpperCase()}</span><span aria-hidden="true"> / </span><span>{otherLocale.toUpperCase()}</span>
      </a>
      <a href={localizedPath(locale, 'home', '#plan')} class="btn btn--primary site-header__cta" data-cta="nav_plan">{t.navigation.plan}</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle data-open-label={t.accessibility.openMenu} data-close-label={t.accessibility.closeMenu}>
        <span class="visually-hidden" data-menu-label>{t.accessibility.openMenu}</span>
        <span class="menu-toggle__bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden data-menu>
    <nav class="container" aria-label={t.navigation.mobile}>
      <ul role="list">
        {nav.map((item) => <li><a href={item.href} aria-current={currentState(item)} data-nav-section={item.section}>{item.label}</a></li>)}
      </ul>
      <div class="mobile-menu__actions">
        <a href={localizedPath(locale, 'home', '#plan')} class="btn btn--primary" data-cta="mobile_nav_plan">{t.navigation.plan}</a>
        <a class="language-switch language-switch--mobile" href={languageHref} hreflang={otherLocale} lang={otherLocale} aria-label={t.switcher.switchTo[otherLocale]} data-language-switch>
          <span aria-current="page">{locale.toUpperCase()}</span><span aria-hidden="true"> / </span><span>{otherLocale.toUpperCase()}</span>
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');
  if (toggle && menu && label) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
      label.textContent = open ? toggle.dataset.closeLabel ?? '' : toggle.dataset.openLabel ?? '';
      document.documentElement.classList.toggle('menu-open', open);
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    menu.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) { setOpen(false); toggle.focus(); }
    });
    window.matchMedia('(min-width: 900px)').addEventListener('change', (e) => { if (e.matches) setOpen(false); });
  }

  // Fragments are not sent to the server. Preserve only shared, safe section anchors.
  const sharedAnchors = new Set(['problem', 'product', 'how-it-works', 'demo', 'faq', 'plan', 'contact']);
  if (sharedAnchors.has(window.location.hash.slice(1))) {
    document.querySelectorAll<HTMLAnchorElement>('[data-language-switch]').forEach((link) => {
      link.hash = window.location.hash;
    });
  }

  const sectionLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-section]')];
  const sections = sectionLinks
    .map((link) => ({ link, id: link.dataset.navSection ?? '', element: document.getElementById(link.dataset.navSection ?? '') }))
    .filter((item): item is { link: HTMLAnchorElement; id: string; element: HTMLElement } => Boolean(item.id && item.element));
  const setCurrentSection = (id: string) => {
    sectionLinks.forEach((link) => {
      if (!link.dataset.navSection) return;
      if (link.dataset.navSection === id) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  };

  if (sections.length) {
    const observer = new IntersectionObserver((entries) => {
      const visible = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      if (visible) setCurrentSection((visible.target as HTMLElement).id);
    }, { rootMargin: '-35% 0px -55%', threshold: [0, 0.1, 0.5] });
    sections.forEach(({ element }) => observer.observe(element));
  }
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: var(--bg); border-bottom: var(--hairline); }
  .site-header__inner { display: flex; align-items: center; justify-content: space-between; gap: var(--s-5); min-height: 72px; }
  .site-nav__list { display: flex; gap: var(--s-6); }
  .site-nav a, .mobile-menu a:not(.btn) { text-decoration: none; color: var(--ink-2); font-weight: 500; font-size: 0.975rem; }
  .site-nav a:hover, .site-nav a[aria-current] { color: var(--ink); }
  .site-nav a[aria-current] { text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 6px; text-decoration-thickness: 2px; }
  .site-header__actions { display: flex; align-items: center; gap: var(--s-3); }
  .site-header__cta { min-height: 42px; padding-inline: 18px; font-size: 0.95rem; }
  .language-switch { color: var(--ink-2); font-family: var(--font-mono); font-size: var(--fs-label); font-weight: 500; letter-spacing: 0.04em; text-decoration: none; white-space: nowrap; }
  .language-switch:hover, .language-switch:focus-visible { color: var(--accent); }
  .language-switch [aria-current='page'] { color: var(--ink); }

  .menu-toggle { display: none; width: 44px; height: 44px; border: 1px solid var(--line-strong); border-radius: var(--r-sm); background: transparent; cursor: pointer; align-items: center; justify-content: center; }
  .menu-toggle__bars, .menu-toggle__bars::before, .menu-toggle__bars::after { display: block; width: 18px; height: 1.5px; background: var(--ink); position: relative; transition: transform 0.2s var(--ease); }
  .menu-toggle__bars::before, .menu-toggle__bars::after { content: ''; position: absolute; inset-inline-start: 0; }
  .menu-toggle__bars::before { top: -6px; }
  .menu-toggle__bars::after { top: 6px; }
  .menu-toggle[aria-expanded='true'] .menu-toggle__bars { background: transparent; }
  .menu-toggle[aria-expanded='true'] .menu-toggle__bars::before { transform: translateY(6px) rotate(45deg); }
  .menu-toggle[aria-expanded='true'] .menu-toggle__bars::after { transform: translateY(-6px) rotate(-45deg); }

  .mobile-menu { border-top: var(--hairline); background: var(--bg); }
  .mobile-menu nav { padding-block: var(--s-4) var(--s-6); }
  .mobile-menu ul { margin-bottom: var(--s-5); }
  .mobile-menu li a { display: flex; align-items: center; min-height: 52px; border-bottom: var(--hairline); font-size: 1.1rem; color: var(--ink); }
  .mobile-menu__actions { display: grid; gap: var(--s-4); }
  .mobile-menu .btn { width: 100%; }
  .language-switch--mobile { justify-self: start; }

  @media (min-width: 900px) { .language-switch--mobile { display: none; } }
  @media (max-width: 899px) { .site-nav { display: none; } .menu-toggle { display: inline-flex; } }
  @media (max-width: 480px) { .site-header__cta { display: none; } .site-header__inner { min-height: 64px; } }
</style>

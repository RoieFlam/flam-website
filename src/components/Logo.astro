---
import type { Locale } from '../i18n';
import { getTranslations, localizedPath } from '../i18n';

interface Props { class?: string; locale: Locale }
const { class: className, locale } = Astro.props;
const t = getTranslations(locale);
---
<a href={localizedPath(locale, 'home')} class:list={['logo', className]} aria-label={t.accessibility.home}>
  <img src="/logo-flam.png" alt="FLAM" width="133" height="26" />
</a>

<style>
  .logo { display: inline-flex; align-items: center; min-height: 44px; }
  .logo img { height: 26px; width: auto; }
  @media (max-width: 480px) { .logo img { height: 22px; } }
</style>

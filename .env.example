# Production URL (no trailing slash). Used for canonical, Open Graph, sitemap and robots.
# Leave empty until the domain is purchased; the site then falls back to http://localhost:4321.
SITE_URL=

# FLAM Base44 intake functions (public, no secrets). See README "Integration contract".
# Leave empty and the form shows a fallback instead of submitting.
PUBLIC_LEAD_ENDPOINT=
PUBLIC_ANALYTICS_ENDPOINT=

# Local testing with the mock server (npm run mock):
# PUBLIC_LEAD_ENDPOINT=http://localhost:8787/submitLead
# PUBLIC_ANALYTICS_ENDPOINT=http://localhost:8787/trackEvent
